{
  "name": "@akshayanimateddsa/root-config",
  "version": "0.1.1",
  "description": "Generic, public shared tooling configuration (TypeScript, ESLint, Prettier, EditorConfig) for the workspace.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akshay-Gupta-19/root-config.git"
  },
  "files": [
    "tsconfig.base.json",
    "eslint.config.base.js",
    ".prettierrc.json",
    ".editorconfig"
  ],
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint": "./eslint.config.base.js",
    "./prettier": "./.prettierrc.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "node scripts/validate.mjs && npm run build -w packages/visual-lab -w packages/docs-check -w packages/site-ui && npm run build -w packages/lab-player",
    "check": "npm run lint && npm run build && npm test && npm pack --dry-run && npm pack --dry-run --workspaces",
    "test": "npm test --workspaces && node packages/docs-check/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependenciesMeta": {
    "@eslint/js": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  }
}
